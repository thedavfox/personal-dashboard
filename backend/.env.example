# Postgres connection for this dashboard app's own data
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/personal_dashboard

# Read-only connection into the separate TODO_List app's MySQL database,
# used by the todo_sync widget
TODO_DB_URL=mysql+aiomysql://user:password@localhost:3306/todo_list

# Auth
JWT_SECRET=change-me-to-a-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# LLM (free tier — get a key at https://console.groq.com/keys)
GROQ_API_KEY=

# Stock data provider (e.g. https://finnhub.io or https://twelvedata.com free tier)
STOCK_API_KEY=
STOCK_API_BASE_URL=https://finnhub.io/api/v1
